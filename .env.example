# Copy to .env for local development. Never commit .env.
#   cp .env.example .env

# Run without a model API key. The API and review UI still start.
DEMO_MODE=true

# Optional — used when DEMO_MODE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Services
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Official pack — used by make sync-data. Not committed.
DATASET_ROOT=/Users/yuhan/Downloads/Ylookup Hackathon Datasets/01-bank-statements-to-journal-entries

# Data locations (relative to repo root)
DATA_DIR=data
HACKATHON_STATEMENTS_DIR=data/hackathon/bank-statements
HACKATHON_REFERENCE_DIR=data/hackathon/reference-data
DEMO_DATA_DIR=data/demo
