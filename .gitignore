# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
credentials.json
**/secrets/
**/service-account*.json

# Python
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
.tox/
.cache/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.turbo/

# Evaluation workbook and any answer-sheet drop — runtime must not use these
data/raw/*
!data/raw/README.md
*.xlsx
*.xls
!tests/fixtures/**/*.xlsx

# Local artefacts
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Docker / cloud
.docker/
.gcloud/
*-key.json

# Never commit ground-truth sheet extracts
**/*staging*
**/*Staging*
**/*DIU*
