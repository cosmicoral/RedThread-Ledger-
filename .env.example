# Copy to .env for local development. Never commit .env.
#   cp .env.example .env

# Deterministic MVP. Do not set a model API key for Cloud Run.
DEMO_MODE=true

# Services (local make demo only)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Cloud Run sets PORT. The container listens on it.
PORT=8080

# Optional. Only needed to refresh committed runtime CSVs or copy the
# evaluation workbook into data/raw/. The demo runs from committed files.
DATASET_ROOT=

# Data locations (relative to repo root)
DATA_DIR=data
HACKATHON_STATEMENTS_DIR=data/hackathon/bank-statements
HACKATHON_REFERENCE_DIR=data/hackathon/reference-data
DEMO_DATA_DIR=data/demo

# Optional Gemini exception agent. Off by default. Never put a key in frontend code.
AGENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ROUNDS=4
